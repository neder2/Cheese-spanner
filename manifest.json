{
    "manifest_version": 3,
    "name": "치즈 스패너",
    "version": "1.3.8",
    "description": "치지직 화질 고정, 재생·채팅 도구, 팔로잉 고정·미리보기, 다시보기 검색·댓글, 방송 목록 필터·통계와 시청 기록을 제공합니다.",
    "icons": {
        "16": "icons/cheese-spanner16.png",
        "48": "icons/cheese-spanner48.png",
        "128": "icons/cheese-spanner128.png"
    },
    "permissions": ["storage", "scripting"],
    "host_permissions": ["https://api.chzzk.naver.com/*", "https://apis.naver.com/*", "https://chzzk.naver.com/*"],
    "optional_host_permissions": ["https://*.pstatic.net/*"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://chzzk.naver.com/*"],
            "js": [
                "features/routeBridgePage.js",
                "features/livePreviewFastHoverPage.js",
                "features/chatTimestampPage.js",
                "features/autoQualityPage.js",
                "shared/volumeControlsPage.js",
                "features/volumeWheelPage.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://chzzk.naver.com/*"],
            "js": [
                "shared/settings.js",
                "shared/data.js",
                "shared/selectors.js",
                "content.js",
                "shared/vodTimeline.js",
                "features/adblockPopup.js",
                "features/adVideo.js",
                "features/adBanner.js",
                "features/headerButtons.js",
                "features/vodReplayChatFix.js",
                "features/vodComments/model.js",
                "features/vodComments/repository.js",
                "features/vodComments/nativeAdapter.js",
                "features/vodComments/view.js",
                "features/vodCommentTabs.js",
                "features/qualityInstallGuide.js",
                "features/autoQuality.js",
                "features/skipControl.js",
                "features/vodBroadcastClock.js",
                "features/timeMachineLagLabel.js",
                "features/livePlayerDisplay.js",
                "features/playerButtons.js",
                "features/streamInfo.js",
                "features/offlineLiveReload.js",
                "features/monthlyBroadcastTime/model.js",
                "features/monthlyBroadcastTime/repository.js",
                "features/monthlyBroadcastTime.js",
                "features/channelChatLink.js",
                "features/liveWatchHistory.js",
                "features/rewardAutoCollect.js",
                "features/chatTools/parser.js",
                "features/chatTools/messageStore.js",
                "features/chatTools/panel.js",
                "features/chatTools.js",
                "features/chatTimestamp.js",
                "features/chatWeeklyRanking.js",
                "features/videoSearch/model.js",
                "features/videoSearch/repository.js",
                "features/videoSearch.js",
                "features/categoryTools/filterModel.js",
                "features/categoryTools/repository.js",
                "features/categoryTools/searchController.js",
                "features/categoryTools.js",
                "features/titleTooltip.js",
                "features/volumeWheel.js",
                "shared/volumeControls.js",
                "features/volumeTooltip.js",
                "features/sidebarCustomization.js",
                "features/followingListState.js",
                "features/followingRefresh.js",
                "features/followingTitleHistory.js",
                "vendor/hls.light.min.js",
                "features/liveMultiview/model.js",
                "features/liveMultiview/view.js",
                "features/liveMultiview/playback.js",
                "features/liveMultiview/layoutControls.js",
                "features/liveMultiview/settingsPanel.js",
                "features/liveMultiview/runtime.js",
                "features/followingPreviewTooltip.js",
                "features/holdSpeed.js",
                "features/screenShortcuts.js",
                "features/playerZoom.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["features/autoQualityPage.js", "vendor/fonts/PretendardVariable.woff2"],
            "matches": ["https://chzzk.naver.com/*"]
        }
    ],
    "action": {
        "default_title": "치즈 스패너 설정",
        "default_popup": "options.html",
        "default_icon": {
            "16": "icons/cheese-spanner16.png",
            "48": "icons/cheese-spanner48.png",
            "128": "icons/cheese-spanner128.png"
        }
    },
    "options_page": "options.html"
}
