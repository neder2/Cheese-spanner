{
    "name": "cheese-spanner",
    "version": "1.4.0",
    "private": true,
    "description": "Development tooling for the Cheese Spanner browser extension.",
    "type": "commonjs",
    "scripts": {
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test \"tests/*.test.js\"",
