        "test:evidence": "node --test \"tests/evidence/*.test.js\"",
        "test:all": "node --test"
    },
    "devDependencies": {
        "@eslint/js": "^9.28.0",
        "eslint": "^9.28.0",
        "globals": "^15.15.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.5.3",
        "web-ext": "^8.7.0"
    },
    "dependencies": {
        "hls.js": "^1.6.16"
    }
}
